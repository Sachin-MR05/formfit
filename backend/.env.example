# Copy to .env and edit. See backend/README.md.
FORMFIT_ENV=development                      # development | production
FORMFIT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
FORMFIT_DATABASE_URL=postgresql://formfit:formfit@localhost:5432/formfit
# sqlite works for quick local tries:  sqlite:///./formfit-dev.db
FORMFIT_CORS_ORIGINS=http://localhost:5173   # comma separated
FORMFIT_TOKEN_TTL_DAYS=14
